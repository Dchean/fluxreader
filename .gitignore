# ---- 构建产物 ----
node_modules/
dist/
dist-test/
src-tauri/target/
src-tauri/gen/schemas/

# ---- 运行时数据（本地 SQLite 与窗口状态，绝不入库）----
*.db
*.db-shm
*.db-wal
.window-state.json

# ---- IDE / 工具 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- 日志与临时文件 ----
*.log
tmp/
.cache/

# ---- 修订备份目录（本地备份产物，不入库）----
_rev501-bak/

# ---- Python 编译缓存（工具脚本）----
__pycache__/
*.pyc

# ---- 本地记忆与宿主会话钩子状态（机器本地数据，与项目无关，不入库）----
.workbuddy/
.mimosa/

# ---- agent 工具的本机配置（由工具自行生成/同步，内容随机器而异）----
.zcodeignore
