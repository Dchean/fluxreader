{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FluxReader",
  "version": "0.8.2",
  "identifier": "com.fluxreader.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FluxReader",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "本地优先的 Windows 桌面 RSS 阅读器",
    "longDescription": "FluxReader 是本地优先的 Windows 桌面 RSS 阅读器：全部数据存于本机 SQLite，直连抓取订阅源，支持五种内容布局、全文搜索、AI 摘要翻译、播客播放与 Miniflux 双向同步。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
